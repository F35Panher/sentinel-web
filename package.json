{
  "name": "sentinel-web",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first Chrome extension for tracker blocking and threat intelligence",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "intel:update": "tsx scripts/update-threat-intel.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}